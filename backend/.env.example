# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

FLASK_ENV=development
PORT=5000

# Comma-separated list of allowed frontend origins for CORS.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-a-random-64-char-hex-string
JWT_EXPIRES_HOURS=168

# Path is relative to backend/ — this file already exists at backend/secrets/firebase-admin.json
FIREBASE_ADMIN_CREDENTIALS_PATH=secrets/firebase-admin.json

# From Cloudinary dashboard -> Settings -> API Keys. The cloud name is public;
# the API key + secret are NOT — fill these in here only, never in frontend code.
CLOUDINARY_CLOUD_NAME=dfim4fhkn
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
