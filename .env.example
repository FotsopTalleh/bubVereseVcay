# Copy to .env.local (or .env) — points the frontend at the local Flask API.
VITE_API_URL=http://localhost:5000/api

# OAuth 2.0 Client ID (Web application) from Google Cloud Console ->
# APIs & Services -> Credentials. Must match backend's GOOGLE_OAUTH_CLIENT_ID.
# The "Continue with Google" button renders only when this is set.
VITE_GOOGLE_CLIENT_ID=
